# ──────────────────────────────────────────────────────────────
# AgroPlace — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha com suas chaves.
# NUNCA commite o .env.local com chaves reais.
# ──────────────────────────────────────────────────────────────

# Supabase — encontre em: Project Settings → API
VITE_SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Opcional: chave de serviço (uso server-side APENAS, nunca no frontend)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
