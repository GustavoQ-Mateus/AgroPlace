# Variáveis de ambiente para produção
# Copie para .env e ajuste conforme necessário

# Chave secreta para JWT (mude em produção!)
JWT_SECRET=troque-por-uma-chave-segura-aqui

# URL da API (vazio = mesmo domínio via nginx proxy)
# Em dev local sem Docker: VITE_API_URL=http://localhost:3001
VITE_API_URL=
